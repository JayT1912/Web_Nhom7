@model Nhom7_webTourdulich.Models.Tour

@{
    ViewData["Title"] = "Edit Tour";
    Layout = "_LayoutAdmin"; 
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Tour</title>
    <link rel="stylesheet" href="~/css/style.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/main.js"></script>
</head>

<body>
    <main>
        <h1>Edit Tour</h1>
        <h4>Tour</h4>
        <hr />

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="MaTour" />

            <div class="form-group">
                <label asp-for="Ten" class="control-label"></label>
                <input asp-for="Ten" class="form-control" />
                <span asp-validation-for="Ten" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaLoaiTour" class="control-label"></label>
                <select asp-for="MaLoaiTour" class="form-control" asp-items="ViewBag.MaLoaiTour"></select>
                <span asp-validation-for="MaLoaiTour" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaGiaTour" class="control-label"></label>
                <select asp-for="MaGiaTour" class="form-control" asp-items="ViewBag.MaGiaTour"></select>
                <span asp-validation-for="MaGiaTour" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaDiemDen" class="control-label"></label>
                <select asp-for="MaDiemDen" class="form-control" asp-items="ViewBag.MaDiemDen"></select>
                <span asp-validation-for="MaDiemDen" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoNgay" class="control-label"></label>
                <input asp-for="SoNgay" class="form-control" />
                <span asp-validation-for="SoNgay" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuongNguoi" class="control-label"></label>
                <input asp-for="SoLuongNguoi" class="form-control" />
                <span asp-validation-for="SoLuongNguoi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MoTa" class="control-label"></label>
                <textarea asp-for="MoTa" class="form-control"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <!-- Optional: Allow updating the image -->
            <div class="form-group">
                <label for="image">Update Image (optional):</label>
                <input type="file" id="image" name="avatar" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
        </form>

        <a href="@Url.Action("Index", "Tour")" class="btn btn-secondary">Back to List</a>
    </main>
</body>
